<div class="fll-wrap">
  <header class="fll-head">
    <div><b>{{scene}}</b>{{#if linked}} · <i class="fa-solid fa-hourglass-half"></i> {{quarter}}{{/if}}</div>
    <div class="fll-volume" data-tooltip="Volume général de toutes les ambiances de lieux, pour toute la table">
      <i class="fa-solid fa-volume-high"></i>
      <input type="range" class="fll-master" min="0" max="150" step="5" value="{{master}}">
      <span class="fll-master-val">{{master}} %</span>
    </div>
    <div class="fll-buttons">
      <button type="button" data-action="tension" class="{{#if tension}}active{{/if}}" data-tooltip="Couche de tension sur toute la scène (battements, bourdon grave)"><i class="fa-solid fa-heart-pulse"></i> Tension</button>
      <button type="button" data-action="combat" class="{{#if combat}}active{{/if}}" data-tooltip="{{#if combat}}En cours : {{combat}} — cliquer pour arrêter{{else}}Musique de combat (au hasard){{/if}}"><i class="fa-solid fa-khanda"></i> Combat</button>
      {{#if combat}}<button type="button" data-action="combatNext" data-tooltip="Autre musique de combat"><i class="fa-solid fa-forward"></i></button>{{/if}}
      <button type="button" data-action="cloche" data-tooltip="Faire sonner la cloche pour tout le monde"><i class="fa-solid fa-bell"></i></button>
      <button type="button" data-action="glas" data-tooltip="Sonner le glas (une mort, un enterrement)"><i class="fa-solid fa-bell-slash"></i> Glas</button>
    </div>
  </header>

  <div class="fll-scroll">
    {{#if sounds.length}}
    <section class="fll-current">
      <h3><i class="fa-solid fa-volume-high"></i> Sur cette scène</h3>
      {{#each sounds}}
      <div class="fll-row">
        <i class="fa-solid {{icon}}"></i>
        <span class="fll-name">{{label}}{{#if whole}} <em>(toute la scène)</em>{{/if}}<small>{{playing}}</small>
          <span class="fll-vol-line"><input type="range" class="fll-vol" data-id="{{id}}" min="0" max="100" step="5" value="{{vol}}" data-tooltip="Volume de cette ambiance"><span class="fll-vol-val">{{vol}} %</span></span></span>
        {{#unless whole}}<button type="button" data-action="pan" data-id="{{id}}" data-tooltip="Montrer sur la carte"><i class="fa-solid fa-location-crosshairs"></i></button>{{/unless}}
        <button type="button" data-action="remove" data-id="{{id}}" data-tooltip="Retirer"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#each groups}}
    <section class="fll-group">
      <h3><i class="fa-solid {{icon}}"></i> {{label}}</h3>
      {{#each lieux}}
      <div class="fll-row" data-lieu="{{id}}">
        <i class="fa-solid {{icon}}"></i>
        <span class="fll-name" data-tooltip="{{hint}}">{{label}}</span>
        <button type="button" data-action="place" data-tooltip="Placer sur la carte (portée {{radius}} cases)"><i class="fa-solid fa-location-dot"></i></button>
        <button type="button" data-action="whole" data-tooltip="Sur toute la scène"><i class="fa-solid fa-expand"></i></button>
      </div>
      {{/each}}
    </section>
    {{/each}}
    <p class="fll-note">Les ambiances sont des sons d'ambiance de Foundry : vous pouvez les déplacer, régler leur portée et leur volume comme d'habitude (outil des sons, à gauche). Elles changent seules selon le Quart et baissent sous la pluie.</p>
  </div>
</div>
